# Ask/chat provider: "openrouter" for hosted inference or "lmstudio" for offline.
LLM_PROVIDER=openrouter
# Gemma 4 emits internal reasoning before its answer, so allow enough room.
LLM_MAX_TOKENS=1024

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cheap hosted default. For higher quality, use deepseek/deepseek-v4-pro.
# Current Gemma alternatives include google/gemma-4-26b-a4b-it and
# google/gemma-4-31b-it.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000
OPENROUTER_APP_NAME=ThisGuyReadMyMind

# LM Studio
# Use http://localhost:1234/v1 when FastAPI runs directly on macOS.
# Docker containers reach the macOS host through host.docker.internal.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=google/gemma-4-e4b
